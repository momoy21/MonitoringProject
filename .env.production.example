# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================
# Copy file ini ke .env di server production
# dan sesuaikan nilai-nilainya

# ==========================================
# APPLICATION
# ==========================================
APP_NAME="Monitoring Project"
APP_ENV=production
APP_KEY=                        # Generate dengan: php artisan key:generate
APP_DEBUG=false                 # PENTING: Harus false di production!
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://your-domain.com # Ganti dengan URL production

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# ==========================================
# DATABASE
# ==========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=monitoring_project
DB_USERNAME=your_db_user        # Ganti dengan user database
DB_PASSWORD=your_db_password    # Ganti dengan password database

# ==========================================
# FTP SERVER (SAP Import)
# ==========================================
FTP_HOST=10.0.1.99              # IP FTP Server
FTP_USERNAME=ftp_user           # Username FTP
FTP_PASSWORD=ftp_password       # Password FTP
FTP_PORT=21
FTP_ROOT=/                      # Root directory FTP
FTP_SOURCE_DIR=/CSV             # Folder sumber file SAP
FTP_PROCESSED_DIR=/Processed    # Folder file sukses
FTP_ERROR_DIR=/Error            # Folder file error
FTP_SSL=false

# ==========================================
# CACHE & SESSION
# ==========================================
CACHE_STORE=file                # atau redis untuk performa lebih baik
SESSION_DRIVER=file             # atau database/redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# ==========================================
# LOGGING
# ==========================================
LOG_CHANNEL=stack
LOG_STACK=daily                 # Rotate log harian
LOG_LEVEL=warning               # Production: warning atau error
LOG_DEPRECATIONS_CHANNEL=null

# ==========================================
# QUEUE (Optional - untuk background jobs)
# ==========================================
QUEUE_CONNECTION=database       # atau redis

# ==========================================
# MAIL (Optional - untuk notifikasi)
# ==========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-mail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# FILESYSTEM
# ==========================================
FILESYSTEM_DISK=local

# ==========================================
# VITE
# ==========================================
VITE_APP_NAME="${APP_NAME}"
